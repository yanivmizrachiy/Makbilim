{
  "name": "makbilim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync:curriculum": "node scripts/sync-curriculum-source.mjs",
    "sync:curriculum:rendered": "python3 scripts/render-bbb-curriculum.py",
    "validate:sources": "node scripts/validate-source-manifest.mjs",
    "validate:curriculum": "node scripts/validate-curriculum-source-integrity.mjs",
    "validate:curriculum:rendered": "node scripts/validate-curriculum-rendered.mjs",
    "validate:numbering": "node scripts/validate-numbering-markers.mjs",
    "validate:question-plan": "node scripts/validate-question-plan.mjs",
    "validate:progression": "node scripts/validate-forward-progress.mjs",
    "validate:pages": "node scripts/validate-page-contract.mjs",
    "test": "vitest run",
    "validate": "npm run validate:sources && npm run validate:curriculum && npm run validate:numbering && npm run validate:question-plan && npm run validate:progression && npm run validate:pages && npm run typecheck && npm run test",
    "pdf": "npm run sync:curriculum:rendered && npm run validate:curriculum:rendered && npm run build && node scripts/build-pdf.mjs",
    "ci": "npm run sync:curriculum && npm run validate && npm run pdf"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mathjax/src": "4.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
